<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Grapevine.Abstractions</PackageId>
    <Description>Abstractions used by Grapevine.</Description>
  </PropertyGroup>

  <PropertyGroup Label="AOT">
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <TrimMode>link</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grapevine.Abstractions.Tests, PublicKey=$(GrapevinePublicKey)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>